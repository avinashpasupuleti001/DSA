class Solution {
    public int findKthLargest(int[] nums, int k) {
        PriorityQueue<Integer> pq = new PriorityQueue<>();
        for(int a:nums){
            pq.add(a);
        }
        int n=pq.size();
        int htr=n-k;
        int ans=-1;
        while(!pq.isEmpty()){
               if(htr==0){
               ans=pq.peek();
               }
            pq.poll();
            htr--;
         }
         return ans;
    }
}
