class Solution {
    ArrayList<Integer> topoSort(ArrayList<ArrayList<Integer>> adj) {
        // code here
        int v=adj.size();
        int indegree[]=new int[v];
        for(int i=0;i<v;i++){
            for(int at:adj.get(i)){
                indegree[at]++;
            }
        }
        Queue<Integer> q=new LinkedList<>();
        for(int i=0;i<v;i++){
           if(indegree[i]==0){
               q.add(i);
           }
        }
        int i=0;
        int topo[]=new int[v];
        while(!q.isEmpty()){
            int ele=q.poll();
            topo[i++]=ele;
            for(int it:adj.get(ele)){
                indegree[it]--;
                if(indegree[it]==0)q.add(it);
            }
        }
        ArrayList<Integer> al=new ArrayList<>();
        for(int j=0;j<v;j++){
            al.add(topo[j]);
        }
        return al;
    }
}
