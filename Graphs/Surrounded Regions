class Solution {
    public void solve(char[][] board) {
        int r=board.length;
        int c=board[0].length;
        int vis[][]=new int[r][c];

        //col 1
        for(int i=0;i<r;i++){
            if(board[i][0]=='O'&& vis[i][0]==0){
               dfs(i,0,vis,board);
            }
        }
        //row 1
        for(int i=0;i<c;i++){
            if(board[0][i]=='O'&& vis[0][i]==0){
                 dfs(0,i,vis,board);
            }
        }
        //last row
        for(int i=0;i<c;i++){
            if(board[r-1][i]=='O'&& vis[r-1][i]==0){
                 dfs(r-1,i,vis,board);
            }
        }
        //last Col
        for(int i=0;i<r;i++){
            if(board[i][c-1]=='O'&& vis[i][c-1]==0){
                dfs(i,c-1,vis,board);
            }
        }

        for(int i=0;i<vis.length;i++){
            for(int j=0;j<vis[0].length;j++){
                if(vis[i][j]!=1&&board[i][j]=='O'){
                   board[i][j]='X';
                }
            }
        }
    }

   public static void dfs(int row,int col,int [][] vis,char[][] board){
        vis[row][col]=1;
        int delrow[]={-1,0,+1,0};
        int delcol[]={0,+1,0,-1};
        int n=board.length;
        int m=board[0].length;
        for(int i=0;i<4;i++){
            int r=row+delrow[i];
            int c=col+delcol[i];
            if(r>=0 && r<n && c>=0 && c<m && vis[r][c]==0 && board[r][c]=='O'){
               dfs(r,c,vis,board);
            }
        }
    }
}
