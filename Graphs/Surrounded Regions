class Solution {
    public void solve(char[][] board) {
        int m=board.length;
        int n=board[0].length;
        int visited[][]=new int[m][n];
        char ans[][]=new char[m][n];
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                ans[i][j]=board[i][j];
            }
        }
        // first column
        for(int i = 0; i < m; i++) {
            if(board[i][0] == 'O' && visited[i][0] == 0) {
                dfs(i, 0, visited, board);
            }
        }

        // last column
        for(int i = 0; i < m; i++) {
            if(board[i][n-1] == 'O' && visited[i][n-1] == 0) {
                dfs(i, n-1, visited, board);
            }
        }

        // first row
        for(int i = 0; i < n; i++) {
            if(board[0][i] == 'O' && visited[0][i] == 0) {
                dfs(0, i, visited, board);
            }
        }

        // last row
        for(int i = 0; i < n; i++) {
            if(board[m-1][i] == 'O' && visited[m-1][i] == 0) {
                dfs(m-1, i, visited, board);
            }
        }

       for(int i=0;i<visited.length;i++){
            for(int j=0;j<visited[i].length;j++){
                if(board[i][j]=='O' && visited[i][j]!=1){
                    ans[i][j]='X';
                }
            }
        }
        
        for(int i=0;i<ans.length;i++){
            for(int j=0;j<ans[i].length;j++){
              board[i][j]=ans[i][j];
            }
        }
    }
    public static void dfs(int i,int j,int [][] visited,char [][] board){
        if(i < 0 || i >= board.length || 
          j < 0 || j >= board[0].length) {
        return;
        }
        if(board[i][j] == 'X' || visited[i][j] == 1) {
                return;
         }
        if(board[i][j] == 'O' && visited[i][j] == 0){
            visited[i][j]=1;
            dfs(i+1,j,visited,board);
            dfs(i,j+1,visited,board);
            dfs(i-1,j,visited,board);
            dfs(i,j-1,visited,board);
        }
    }
}
