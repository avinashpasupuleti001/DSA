class Solution {
    class Node{
        int row,col,dist;
        Node(int row,int col,int dist){
            this.row=row;
            this.col=col;
            this.dist=dist;
        }
    }
    public int[][] updateMatrix(int[][] mat) {
        Queue<Node> q=new LinkedList<>();
        int m=mat.length;
        int n=mat[0].length;
        int visited[][]=new int[m][n];
        int ans[][]=new int[m][n];
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
              if(mat[i][j]==0 && visited[i][j]==0){
                visited[i][j]=1;
                q.add(new Node(i, j, 0));
              }
            }
        }
        int []dRow={-1,0,1,0};
        int []dCol={0,1,0,-1};
        while(!q.isEmpty()){
            Node curr=q.poll();
            int r=curr.row;
            int c=curr.col;
            int d=curr.dist;
            ans[r][c]=d;
            for (int i = 0; i < 4; i++) {
                int nr = r + dRow[i];
                int nc = c + dCol[i];
               if (nr >= 0 && nr < m && nc >= 0 && nc < n && visited[nr][nc] == 0) {
                    visited[nr][nc] = 1;
                    q.add(new Node(nr, nc, d + 1));
                }
            }
        }
        return ans;
    }
}
