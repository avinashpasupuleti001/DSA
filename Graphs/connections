
✅ Number of Operations to Make Network Connected

class Solution {
    public int makeConnected(int n, int[][] connections) {
        int edges = connections.length;

        if (edges < n - 1)
            return -1;
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            adj.add(new ArrayList<>());
        }

        for (int[] edge : connections) {
            int u = edge[0];
            int v = edge[1];

            adj.get(u).add(v);
            adj.get(v).add(u);
        }
        int com=0;
        int vis[] = new int[n];
        for (int i = 0; i < n; i++) {
            if (vis[i] == 0) {
                com++;
                bfs(adj, vis, i);
            }
        }

        return com - 1;
    }

    public void bfs(ArrayList<ArrayList<Integer>> adj, int[] vis, int start) {
        Queue<Integer> q = new LinkedList<>();

        q.add(start);
        vis[start] = 1;

        while (!q.isEmpty()) {
            int node = q.poll();

            for (int nei : adj.get(node)) {
                if (vis[nei] == 0) {
                    vis[nei] = 1;
                    q.add(nei);
                }
            }
        }
    }
}
